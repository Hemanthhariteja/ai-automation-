# Copy this file to .env and fill in only what you actually use.
# The app runs fully in Demo Mode with NONE of these set.

ENVIRONMENT=development
DEBUG=true

# Auth — change this in any real deployment
SECRET_KEY=dev-only-secret-change-me

# Database
DATABASE_URL=sqlite:///./app.db

# AI provider selection: demo | local | free_api | openai | gemini
AI_PROVIDER=demo
AI_FALLBACK_PROVIDER=demo

# Optional providers — leave blank to stay in Demo Mode
OPENAI_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Frontend origin allowed for CORS
FRONTEND_ORIGIN=http://localhost:5173
